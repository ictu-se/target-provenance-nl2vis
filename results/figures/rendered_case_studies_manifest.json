{
  "case_selection": "Post-hoc explanatory cases covering filter retention, specification mapping, multiple acceptable interpretations, exact-match brittleness, and a staged counterexample.",
  "rendering_note": "Renderer-required type declarations and presentation properties were added; marks, fields, aggregates, and filters were not changed.",
  "cases": [
    {
      "record_id": "nvbench2:test:14",
      "query": "Which coaches are represented in the pie chart for Robert Chen, Joe Fabbri, or Jameson Tomas?",
      "csv_file": "riding_club@coach.csv",
      "panels": [
        {
          "title": "(a) Qwen direct top 1",
          "note": "Filter omitted: all five coaches remain",
          "spec": {
            "encoding": {
              "color": {
                "field": "coach_name"
              },
              "theta": {
                "aggregate": "count",
                "field": "coach_name"
              }
            },
            "mark": "arc"
          }
        },
        {
          "title": "(b) Qwen staged top 1 = Gold 1",
          "note": "Requested filter retained; equal counts",
          "spec": {
            "encoding": {
              "color": {
                "field": "coach_name"
              },
              "theta": {
                "aggregate": "count"
              }
            },
            "mark": "arc",
            "transform": [
              {
                "filter": {
                  "field": "coach_name",
                  "oneOf": [
                    "Jameson Tomas",
                    "Joe Fabbri",
                    "Robert Chen"
                  ]
                }
              }
            ]
          }
        },
        {
          "title": "(c) Benchmark Gold 2",
          "note": "Same filter; rank controls slice angle",
          "spec": {
            "mark": "arc",
            "encoding": {
              "color": {
                "field": "coach_name"
              },
              "theta": {
                "field": "rank"
              }
            },
            "transform": [
              {
                "filter": {
                  "field": "coach_name",
                  "oneOf": [
                    "Robert Chen",
                    "Joe Fabbri",
                    "Jameson Tomas"
                  ]
                }
              }
            ]
          }
        }
      ]
    },
    {
      "record_id": "nvbench2:test:77",
      "query": "The scatter plot displays the total number of entries by games played and league.",
      "csv_file": "baseball_1@team_half.csv",
      "panels": [
        {
          "title": "(a) Qwen direct top 1",
          "note": "Aggregates collapse the requested mapping",
          "spec": {
            "encoding": {
              "x": {
                "aggregate": "sum",
                "field": "g"
              },
              "y": {
                "aggregate": "count",
                "field": "league_id"
              }
            },
            "mark": "point"
          }
        },
        {
          "title": "(b) Qwen staged top 1 = Gold 4",
          "note": "Games, wins, league, and count are retained",
          "spec": {
            "encoding": {
              "color": {
                "field": "league_id"
              },
              "size": {
                "aggregate": "count"
              },
              "x": {
                "field": "g"
              },
              "y": {
                "field": "w"
              }
            },
            "mark": "point"
          }
        },
        {
          "title": "(c) Benchmark Gold 1",
          "note": "Alternative mapping uses rank and games",
          "spec": {
            "mark": "point",
            "encoding": {
              "size": {
                "aggregate": "count"
              },
              "y": {
                "field": "g"
              },
              "color": {
                "field": "league_id"
              },
              "x": {
                "field": "rank"
              }
            }
          }
        }
      ]
    },
    {
